// Windows version resource for XMALab.exe, configured by CMake from the project
// version and PROJECT_BETA_VERSION. Shows up in the file's Properties > Details.
// Numeric constants are written out so the SDK headers are not needed by rc.exe.

1 VERSIONINFO
 FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@XMALAB_BETA_NUMBER@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@XMALAB_BETA_NUMBER@
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      @XMALAB_VS_FILEFLAGS@
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "XROMM"
            VALUE "FileDescription",  "XMALab"
            VALUE "FileVersion",      "@XMALAB_DISPLAY_VERSION@"
            VALUE "InternalName",     "XMALab"
            VALUE "LegalCopyright",   "Copyright (c) 2015, Brown University. GPL v3."
            VALUE "OriginalFilename", "XMALab.exe"
            VALUE "ProductName",      "XMALab"
            VALUE "ProductVersion",   "@XMALAB_DISPLAY_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
