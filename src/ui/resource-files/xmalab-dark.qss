/* XMALab Modern Dark Theme
 * Cross-platform stylesheet for Windows, macOS, and Linux
 * Designed for Qt6 Fusion style
 */

/* === Global === */
QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-family: "Segoe UI", "SF Pro Text", "Noto Sans", sans-serif;
    font-size: 13px;
}

/* === Main Window & Dock Widgets === */
QMainWindow {
    background-color: #2d2d2d;
}

QDockWidget {
    background-color: #2d2d2d;
    border: 1px solid #3d3d3d;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #383838;
    padding: 4px;
    border-bottom: 1px solid #3d3d3d;
    font-weight: bold;
}

/* === Toolbars === */
QToolBar {
    background-color: #383838;
    border: none;
    border-bottom: 1px solid #3d3d3d;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background-color: #4d4d4d;
    width: 1px;
    margin: 4px 8px;
}

/* === Buttons === */
QPushButton {
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 6px 14px;
    color: #e0e0e0;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #4d4d4d;
    border-color: #5d5d5d;
}

QPushButton:pressed {
    background-color: #2d2d2d;
    border-color: #3d3d3d;
}

QPushButton:disabled {
    background-color: #2d2d2d;
    color: #666666;
    border-color: #3d3d3d;
}

QPushButton:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
}

QPushButton:checked:hover {
    background-color: #1a8ae8;
    border-color: #1a8ae8;
}

/* === Tool Buttons === */
QToolButton {
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e0e0e0;
    min-height: 24px;
}

QToolButton:hover {
    background-color: #4d4d4d;
    border-color: #5d5d5d;
}

QToolButton:pressed {
    background-color: #2d2d2d;
    border-color: #3d3d3d;
}

QToolButton:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
}

QToolButton:disabled {
    background-color: #2d2d2d;
    color: #666666;
    border-color: #3d3d3d;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right: 4px;
}

/* === Group Boxes === */
QGroupBox {
    background-color: #2d2d2d;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #b0b0b0;
}

/* === Line Edits === */
QLineEdit {
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e0e0e0;
    selection-background-color: #0078d4;
}

QLineEdit:focus {
    border-color: #0078d4;
}

QLineEdit:disabled {
    background-color: #2d2d2d;
    color: #666666;
    border-color: #3d3d3d;
}

/* === Text Edits === */
QTextEdit {
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 6px;
    color: #e0e0e0;
    selection-background-color: #0078d4;
}

/* === Combo Boxes === */
QComboBox {
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e0e0e0;
    min-height: 24px;
}

QComboBox:hover {
    border-color: #5d5d5d;
}

QComboBox:focus {
    border-color: #0078d4;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #4d4d4d;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: #4d4d4d;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #b0b0b0;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    selection-background-color: #0078d4;
    color: #e0e0e0;
    outline: none;
}

/* === Spin Boxes === */
QSpinBox, QDoubleSpinBox {
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e0e0e0;
    min-height: 24px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #5d5d5d;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #0078d4;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #4d4d4d;
    border-top-right-radius: 4px;
    background-color: #4d4d4d;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid #4d4d4d;
    border-bottom-right-radius: 4px;
    background-color: #4d4d4d;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #5d5d5d;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #b0b0b0;
    margin-bottom: 2px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #b0b0b0;
    margin-top: 2px;
}

/* === Sliders === */
QSlider::groove:horizontal {
    background-color: #4d4d4d;
    border-radius: 4px;
    height: 6px;
}

QSlider::handle:horizontal {
    background-color: #0078d4;
    border-radius: 6px;
    width: 14px;
    margin: -4px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #1a8ae8;
}

QSlider::groove:vertical {
    background-color: #4d4d4d;
    border-radius: 4px;
    width: 6px;
}

QSlider::handle:vertical {
    background-color: #0078d4;
    border-radius: 6px;
    height: 14px;
    margin: 0 -4px;
}

QSlider::handle:vertical:hover {
    background-color: #1a8ae8;
}

/* === Scroll Bars === */
QScrollBar:horizontal {
    background-color: #2d2d2d;
    height: 14px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #4d4d4d;
    border-radius: 6px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5d5d5d;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
}

QScrollBar:vertical {
    background-color: #2d2d2d;
    width: 14px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #4d4d4d;
    border-radius: 6px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5d5d5d;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}

/* === Progress Bars === */
QProgressBar {
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    border-radius: 4px;
    text-align: center;
    height: 20px;
    color: #e0e0e0;
}

QProgressBar::chunk {
    background-color: #0078d4;
    border-radius: 3px;
}

/* === Tree Widgets & Tables === */
QTreeWidget, QTableView, QTableWidget {
    background-color: #2d2d2d;
    alternate-background-color: #333333;
    border: 1px solid #3d3d3d;
    border-radius: 4px;
    gridline-color: #3d3d3d;
    selection-background-color: #0078d4;
    selection-color: #ffffff;
}

QTreeWidget::item, QTableWidget::item {
    padding: 3px 4px;
    border: none;
}

QTreeWidget::item:hover, QTableWidget::item:hover {
    background-color: #3d3d3d;
}

QTreeWidget::item:selected, QTableWidget::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #383838;
    border: none;
    border-bottom: 1px solid #3d3d3d;
    border-right: 1px solid #3d3d3d;
    padding: 4px 8px;
    color: #b0b0b0;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #4d4d4d;
}

/* === Tab Widgets === */
QTabWidget::pane {
    background-color: #2d2d2d;
    border: 1px solid #3d3d3d;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #383838;
    border: 1px solid #3d3d3d;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 6px 16px;
    color: #b0b0b0;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background-color: #4d4d4d;
    color: #e0e0e0;
}

QTabBar::tab:selected {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border-bottom: 2px solid #0078d4;
}

/* === Check Boxes & Radio Buttons === */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e0e0e0;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #3d3d3d;
    border: 1px solid #4d4d4d;
    border-radius: 3px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #5d5d5d;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #2d2d2d;
    border-color: #3d3d3d;
}

QRadioButton::indicator {
    border-radius: 8px;
}

/* === Labels === */
QLabel {
    color: #e0e0e0;
    background-color: transparent;
}

/* === Splitter === */
QSplitter::handle {
    background-color: #3d3d3d;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #0078d4;
}

/* === Menu === */
QMenu {
    background-color: #2d2d2d;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 28px 6px 20px;
    border-radius: 4px;
    color: #e0e0e0;
}

QMenu::item:selected {
    background-color: #3d3d3d;
}

QMenu::separator {
    background-color: #3d3d3d;
    height: 1px;
    margin: 4px 8px;
}

/* === Status Bar === */
QStatusBar {
    background-color: #383838;
    border-top: 1px solid #3d3d3d;
    color: #b0b0b0;
}

/* === Dialogs === */
QDialog {
    background-color: #2d2d2d;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
}

/* === Message Box === */
QMessageBox {
    background-color: #2d2d2d;
}

QMessageBox QLabel {
    color: #e0e0e0;
}

/* === File Dialog === */
QFileDialog {
    background-color: #2d2d2d;
}

/* === Wizard === */
QWizard {
    background-color: #2d2d2d;
}

QWizard QPushButton {
    min-width: 80px;
}

/* === OpenGL widgets - keep transparent background === */
QOpenGLWidget {
    background-color: #000000;
}

/* === Scroll Area === */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* === Frame === */
QFrame {
    background-color: transparent;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    background-color: #3d3d3d;
}

/* === Line (horizontal/vertical) === */
Line {
    background-color: #3d3d3d;
}
